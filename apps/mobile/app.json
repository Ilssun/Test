{
  "expo": {
    "name": "Carnet d'entraînement",
    "slug": "carnet-entrainement",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "carnetentrainement",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.carnetentrainement.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F1EEE3"
      },
      "package": "com.carnetentrainement.app"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      "expo-document-picker",
      "expo-image-picker",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F1EEE3",
          "image": "./assets/icon.png",
          "imageWidth": 200
        }
      ]
    ]
  }
}
