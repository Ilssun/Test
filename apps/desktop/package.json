{
  "name": "carnet-desktop",
  "version": "1.0.0",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win"
  },
  "devDependencies": {
    "app-builder-bin": "4.0.0",
    "electron": "^32.1.2",
    "electron-builder": "24.13.3"
  },
  "build": {
    "electronVersion": "32.3.3",
    "appId": "com.carnetentrainement.app",
    "productName": "Carnet d'entraînement",
    "files": ["main.js", "preload.js", "web/**/*"],
    "directories": { "output": "release" },
    "win": {
      "target": ["nsis"],
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
