rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function me() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isActive() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && me().status == 'active';
    }

    function isAdmin() {
      return isActive() && me().role == 'admin';
    }

    // Reading the member list must be public (not just isSignedIn()): looking
    // up a username's synthetic email happens BEFORE authentication, both at
    // signup (duplicate-name check) and at login (username -> email lookup).
    // No sensitive data lives on these docs (no password hashes — Firebase
    // Auth owns that), so this is safe. Only creating/editing/deleting a
    // profile requires being signed in.
    match /users/{userId} {
      allow read: if true;

      // Self-signup can only ever create a pending, non-admin profile.
      // The first account of a fresh deployment must be promoted to
      // admin/active by hand from the Firebase console (see README).
      allow create: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.id == userId
        && request.resource.data.role == 'member'
        && request.resource.data.status == 'pending';

      allow update: if isAdmin()
        || (isSignedIn() && request.auth.uid == userId
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['username', 'usernameLower', 'groupId']));

      allow delete: if isAdmin();
    }

    // Also public: the signup screen lists groups in a dropdown before login.
    match /groups/{groupId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /accounts/{accountId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /transactions/{txId} {
      allow read: if isActive();
      allow create: if isActive() && request.resource.data.userId == request.auth.uid;
      allow delete: if isActive() && (resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isAdmin();
    }
  }
}
